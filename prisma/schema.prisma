generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL con pooler (PgBouncer) para runtime; directa para migraciones.
  // Las inyecta la integración Neon de Vercel.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Rifas / sorteos. La cantidad total de números (totalNumbers) es un dato
// INTERNO preparado para la fase de numeración automática: nunca se muestra
// al público, solo el porcentaje de avance.
model Raffle {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  prize        String
  imageUrl     String?
  priceCop     Int?
  drawDateText String?
  progressPct  Int      @default(0)
  status       String   @default("active") // active | coming_soon | finished | sold_out
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  totalNumbers Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Winner {
  id           String   @id @default(cuid())
  name         String
  prize        String
  raffleTitle  String?
  photoUrl     String?
  drawnAtText  String?
  isDemo       Boolean  @default(true)
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
