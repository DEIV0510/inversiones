generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL con pooler (PgBouncer) para runtime; directa para migraciones.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ============================================================
// RIFAS
// ============================================================

enum RaffleStatus {
  DRAFT
  COMING_SOON
  ACTIVE
  SOLD_OUT
  FINISHED
  CANCELLED
}

enum ProgressMode {
  AUTO // vendidos / total (calculado)
  MANUAL // porcentaje fijado por el administrador
}

// Cómo puede elegir números el comprador en esta rifa.
enum SelectionMode {
  MANUAL // solo eligiendo/buscando sus números
  RANDOM // solo al azar (el sistema los asigna)
  BOTH // las dos opciones
}

model Raffle {
  id                 String       @id @default(cuid())
  slug               String       @unique
  title              String
  description        String       @default("")
  prize              String
  imageUrl           String?
  galleryJson        String       @default("[]") // URLs de imágenes adicionales
  pricePerNumber     Int // COP por número
  totalNumbers       Int // 10.000 / 100.000 / 1.000.000...
  digits             Int // 4, 5, 6... (formato 00042)
  startsAt           DateTime?
  drawsAt            DateTime?
  drawDateText       String? // texto visible flexible ("30 de agosto con Sinuano")
  status             RaffleStatus @default(DRAFT)
  progressMode       ProgressMode @default(AUTO)
  manualProgressPct  Int          @default(0)
  paidCount          Int          @default(0) // contador atómico de números pagados
  reservationMinutes Int          @default(10)
  // Compra mínima: por debajo de esto el sistema rechaza el pedido. Suele
  // coincidir con el paquete más pequeño que ofrece la rifa.
  minNumbersPerOrder Int          @default(1)
  maxNumbersPerOrder Int          @default(20)
  terms              String       @default("")
  displayOrder       Int          @default(0)

  // Cómo elige el comprador sus números.
  selectionMode SelectionMode @default(BOTH)
  // Si la compra se cierra por WhatsApp. Apagado, esta rifa no muestra
  // WhatsApp por ningún lado al comprador.
  whatsappCheckout Boolean @default(true)
  // Cantidades de boletas ofrecidas como botones rápidos, ej "[1,2,5,10,20]".
  ticketPacksJson String @default("[1,2,5,10]")
  // Premios adicionales de la rifa (mayor, anticipados por día...).
  // [{ label, title, amount, note }]
  prizesJson String @default("[]")
  // Filas opcionales de la ficha del sorteo. El premio nace apagado porque el
  // dueño ya lo escribe dentro del título; la fecha nace encendida y cuando no
  // hay texto se lee "Por anunciar".
  showPrize    Boolean @default(false)
  showDrawDate Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numbers        RaffleNumber[]
  orders         Order[]
  winners        Winner[]
  prizedNumbers  PrizedNumber[]

  @@index([status, displayOrder])
}

// ============================================================
// MOTOR DE NÚMEROS — asignación perezosa
// Solo existe fila para números TOMADOS (reservado/pagado/bloqueado).
// Disponible = ausencia de fila. UNIQUE(raffleId, number) es la garantía
// definitiva contra ventas duplicadas, a nivel de base de datos.
// ============================================================

enum NumberStatus {
  RESERVED
  PAID
  BLOCKED
}

model RaffleNumber {
  id            String       @id @default(cuid())
  raffleId      String
  number        Int
  status        NumberStatus
  orderId       String?
  reservedUntil DateTime?
  createdAt     DateTime     @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@index([orderId])
  @@index([status, reservedUntil])
}

/// Ticket premiado: número con premio instantáneo. Opcional por rifa.
model PrizedNumber {
  id        String   @id @default(cuid())
  raffleId  String
  number    Int
  prize     String
  claimedAt DateTime?
  orderId   String?
  createdAt DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, number])
  @@index([raffleId, claimedAt])
}

// ============================================================
// PARTICIPANTES Y PEDIDOS
// ============================================================

model Participant {
  id        String   @id @default(cuid())
  phone     String   @unique // normalizado 57XXXXXXXXXX
  name      String
  email     String?
  // Cédula: opcional al comprar, sirve para que el comprador encuentre sus
  // boletas si no recuerda el código ni con qué teléfono compró.
  idNumber  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
  @@index([idNumber])
}

enum OrderStatus {
  PENDING // números reservados, esperando pago
  PAID
  EXPIRED
  CANCELLED
  REJECTED
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // código de participación (credencial del comprador)
  raffleId      String
  participantId String
  numbersJson   String // JSON int[] — snapshot para comprobante e historial
  quantity      Int
  unitPrice     Int
  total         Int
  status        OrderStatus @default(PENDING)
  paymentMethod String? // wompi | whatsapp | manual
  reservedUntil DateTime?
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  raffle      Raffle         @relation(fields: [raffleId], references: [id])
  participant Participant    @relation(fields: [participantId], references: [id])
  numbers     RaffleNumber[]
  payments    Payment[]

  @@index([raffleId, status])
  @@index([participantId])
  @@index([status, reservedUntil])
  @@index([status, paidAt])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  orderId      String
  provider     String // wompi | manual
  providerTxId String?  @unique // id de transacción de la pasarela (idempotencia)
  reference    String? // referencia enviada a la pasarela
  amount       Int
  currency     String   @default("COP")
  status       String // PENDING | APPROVED | DECLINED | VOIDED | ERROR
  rawJson      String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([reference])
}

// ============================================================
// GANADORES
// ============================================================

model Winner {
  id              String   @id @default(cuid())
  raffleId        String?
  raffleTitle     String // snapshot por si la rifa se elimina
  numberValue     Int?
  numberFormatted String?
  participantId   String?
  participantName String
  prize           String
  drawnAtText     String?
  photoUrl        String? // evidencia / foto de entrega
  isDemo          Boolean  @default(false)
  isPublished     Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  raffle Raffle? @relation(fields: [raffleId], references: [id], onDelete: SetNull)

  @@index([isPublished, displayOrder])
}

// ============================================================
// USUARIOS ADMINISTRATIVOS Y AUDITORÍA
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SOPORTE
  FINANZAS
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorRole  String
  action     String // raffle.create, order.confirm_payment, number.block...
  entity     String
  entityId   String?
  detailJson String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorEmail])
}

// ============================================================
// CONFIGURACIÓN
// ============================================================

model Setting {
  key   String @id
  value String
}
