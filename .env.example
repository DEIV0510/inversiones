# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Base de datos Postgres (Neon vía Vercel). Obtén los valores con:
# vercel env pull .env.vercel --environment=production
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Secreto para firmar la sesión del panel (64+ caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Credenciales del administrador.
ADMIN_EMAIL="admin@inversionesdys.com"
# Genera el valor con: npm run hash-password -- "TuContraseña"
# (el comando entrega el hash ya codificado en base64, listo para pegar aquí)
ADMIN_PASSWORD_HASH=""

# URL pública del sitio (para SEO / Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:5236"

# Opcional: token de Vercel Blob para guardar imágenes en la nube.
# Sin él, las imágenes se guardan en public/uploads (desarrollo local).
# BLOB_READ_WRITE_TOKEN=""
