# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# ── Base de datos Postgres (Neon vía Vercel) ─────────────────────────
# Obtén los valores con: vercel env pull .env.vercel --environment=production
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ── Sesión del panel ─────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# ── Bootstrap del SUPER_ADMIN (lo crea el seed) ──────────────────────
ADMIN_EMAIL="admin@inversionesdys.com"
# Genera el valor con: npm run hash-password -- "TuContraseña"
# (entrega el hash bcrypt ya codificado en base64, listo para pegar)
ADMIN_PASSWORD_HASH=""

# ── Sitio ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:5236"

# ── Cron (producción) ────────────────────────────────────────────────
# Vercel lo envía como "Authorization: Bearer <valor>" al cron.
CRON_SECRET=""

# ── Vercel Blob (producción; en local las imágenes van a public/uploads)
# BLOB_READ_WRITE_TOKEN=""

# ── Wompi (opcional: activa el pago en línea — ver docs/PAGOS.md) ────
# WOMPI_PUBLIC_KEY="pub_test_..."
# WOMPI_INTEGRITY_SECRET="test_integrity_..."
# WOMPI_EVENTS_SECRET="test_events_..."
