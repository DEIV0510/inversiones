# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# ── Base de datos Postgres (Neon vía Vercel) ─────────────────────────
# Obtén los valores con: vercel env pull .env.vercel --environment=production
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ── Sesión del panel ─────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# ── Bootstrap del SUPER_ADMIN (lo crea el seed) ──────────────────────
ADMIN_EMAIL="admin@inversionesdys.com"
# Genera el valor con: npm run hash-password -- "TuContraseña"
# (entrega el hash bcrypt ya codificado en base64, listo para pegar)
ADMIN_PASSWORD_HASH=""

# ── Sitio ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:5236"

# ── Cron (producción) ────────────────────────────────────────────────
# Vercel lo envía como "Authorization: Bearer <valor>" al cron.
CRON_SECRET=""

# ── Vercel Blob (producción; en local las imágenes van a public/uploads)
# BLOB_READ_WRITE_TOKEN=""

# ── Pasarela de pago (opcional: activa el pago en línea) ─────────────
# Ver docs/PAGOS.md. Con las dos configuradas, se usa BOLD.
# Sin ninguna, la plataforma cobra por WhatsApp + confirmación en el panel.

# Bold — Panel de Comercios (https://comercios.bold.co) → Integraciones →
# Llaves de integración. La de IDENTIDAD es pública (viaja al navegador);
# la SECRETA firma el botón y valida el webhook: nunca sale del servidor.
# BOLD_IDENTITY_KEY=""
# BOLD_SECRET_KEY=""
# Solo para el sandbox EN LOCAL: en pruebas Bold firma el webhook con la
# llave secreta VACÍA. Se ignora en un despliegue de producción.
# BOLD_ENV="test"

# Wompi (segunda pasarela; se mantiene por los pagos ya cobrados con ella)
# WOMPI_PUBLIC_KEY="pub_test_..."
# WOMPI_INTEGRITY_SECRET="test_integrity_..."
# WOMPI_EVENTS_SECRET="test_events_..."
